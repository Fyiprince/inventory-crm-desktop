{
  "name": "inventory-crm-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "postinstall": "prisma generate && node scripts/sync-template-db.js",
    "prisma:generate": "prisma generate",
    "prisma:sync-template": "node scripts/sync-template-db.js",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push --skip-generate --accept-data-loss"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "16.4.5",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
